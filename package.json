{
  "name": "nbu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop scheduler for the NBU store using an AdsPower browser profile",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "npm run build && node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:parallel": "node scripts/test-parallel-cart.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "patchright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
