# Pass this variable to npm start through your shell; this file is documentation only.
# The key can also be entered in the app. Keys entered in Settings persist encrypted with Electron safeStorage, separately from the task database.
ADSPOWER_API_KEY=

# License-server connection. HTTP is allowed only on localhost.
# These values can be embedded by passing them when running npm run build.
NBU_LICENSE_SERVER_URL=http://127.0.0.1:8000
NBU_LICENSE_PUBLIC_KEY=qKP9QqxYMdxx1M9Ogrvb5wYi/cAmnhT4g8AQAXJITpY=
# Test builds accept NBU2-TEST-FRND-2626 without contacting the server.
# Set false at BUILD time to remove test access from a release.
NBU_DESKTOP_ALLOW_TEST_LICENSE=true
